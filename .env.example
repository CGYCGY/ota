# Required
PUBLIC_BASE_URL=https://install.example.com   # https subdomain Coolify provisions a cert for; no trailing slash
ADMIN_PASSWORD=change-me                       # password for the human /login (gates the upload form)
SESSION_SECRET=change-me-to-a-long-random-string  # signs session cookies

# Optional (defaults shown)
DATA_DIR=/data                                 # storage root + token store; mount a volume here
TTL_HOURS=24                                   # retention before auto-delete
PORT=3000
MAX_UPLOAD_MB=300                              # reject larger bodies
SESSION_TTL_HOURS=168                          # how long a human login stays valid (7d)
